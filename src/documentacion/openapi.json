                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Permisos insuficientes",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RespuestaError"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Recurso no encontrado o no disponible",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RespuestaError"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Conflicto con las reglas del negocio",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RespuestaError"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Error interno del servidor",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RespuestaError"
                                }
                            }
                        }
                    }
                }
            },
            "get": {
                "tags": [
                    "Reservas"
                ],
                "summary": "Consultar reservas propias",
                "description": "El usuario solamente puede consultar sus reservas. La identidad se obtiene del JWT.",
                "security": [
                    {
                        "AutenticacionJWT": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Historial obtenido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Reserva"
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Autenticacion requerida o token invalido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RespuestaError"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Permisos insuficientes",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RespuestaError"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Error interno del servidor",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RespuestaError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/nutricionistas": {
            "get": {
                "tags": [
                    "Nutricionistas"
